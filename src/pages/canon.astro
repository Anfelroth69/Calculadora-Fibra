---
import Base from '../layouts/Base.astro';
---

<Base title="Calculadora Fibra · Canon" theme="canon">
  <div class="mx-auto max-w-5xl px-4 pb-20 pt-6 sm:px-6">
    <header class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-zinc-500">Calculadora Fibra · uso interno</p>
        <h1 id="calc-title" class="mt-1 text-3xl font-bold tracking-tight">Cotiza tu tobogán</h1>
      </div>
      <nav aria-label="Versiones" class="flex items-center gap-2 text-sm">
        <span class="rounded-full bg-zinc-900 px-3 py-1 font-semibold text-white">Canon shadcn</span>
        <a href="/" class="rounded-full border border-zinc-300 bg-white px-3 py-1 font-medium hover:border-zinc-900">Principal</a>
        <span class="rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800">Sin login · provisional</span>
      </nav>
    </header>

    <div class="mt-6 flex gap-2" role="tablist" aria-label="Secciones">
      <button id="tab-quote" role="tab" aria-selected="true" class="rounded-lg bg-zinc-900 px-4 py-2 text-sm font-semibold text-white">Cotizar</button>
      <button id="tab-admin" role="tab" aria-selected="false" class="rounded-lg border border-zinc-300 bg-white px-4 py-2 text-sm font-semibold text-zinc-700">Administración</button>
    </div>

    <main class="mt-4 grid gap-4 lg:grid-cols-[1.2fr_1fr]">
      <section id="panel-quote" role="tabpanel" aria-labelledby="tab-quote" class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-semibold">Nueva cotización</h2>
        <p id="calc-note" class="mt-1 text-sm text-zinc-500">Valores provisionales por metro lineal.</p>

        <fieldset class="mt-5">
          <legend class="text-sm font-semibold">Tipo de tobogán</legend>
          <div class="mt-2 grid grid-cols-2 gap-2" role="radiogroup" aria-label="Tipo">
            <button id="type-recto" role="radio" aria-checked="true" class="rounded-xl border-2 border-zinc-900 bg-zinc-50 p-4 text-left">
              <span class="block text-sm font-bold">Recto</span>
              <span id="price-recto-label" class="tnum mt-1 block text-sm text-zinc-600">$ 800.000 / m</span>
            </button>
            <button id="type-curvo" role="radio" aria-checked="false" class="rounded-xl border border-zinc-200 bg-white p-4 text-left">
              <span class="block text-sm font-bold">Curvo</span>
              <span id="price-curvo-label" class="tnum mt-1 block text-sm text-zinc-600">$ 1.000.000 / m</span>
            </button>
          </div>
        </fieldset>

        <div class="mt-6">
          <div class="flex items-end justify-between gap-3">
            <label for="longitud" class="text-sm font-semibold">Longitud (metros)</label>
            <div class="flex items-center gap-2">
              <input id="longitud-num" type="number" min="1" max="30" step="0.5" value="5"
                class="tnum w-24 rounded-lg border border-zinc-300 px-3 py-2 text-right text-lg font-bold" />
              <span class="text-sm text-zinc-500">m</span>
            </div>
          </div>
          <input id="longitud" type="range" min="1" max="30" step="0.5" value="5" class="mt-3 w-full accent-zinc-900" />
          <p id="range-hint" class="mt-1 text-xs text-zinc-500">Rango permitido: 1 – 30 m.</p>
          <p id="quote-error" class="mt-2 hidden text-sm font-medium text-red-600" role="alert"></p>
        </div>

        <dl class="mt-6 space-y-2 rounded-xl bg-zinc-50 p-4 text-sm">
          <div class="flex justify-between"><dt class="text-zinc-500">Precio unitario</dt><dd id="d-unit" class="tnum font-semibold">$ 800.000 / m</dd></div>
          <div class="flex justify-between"><dt class="text-zinc-500">Longitud</dt><dd id="d-len" class="tnum font-semibold">5 m</dd></div>
          <div class="flex justify-between"><dt class="text-zinc-500">Tipo</dt><dd id="d-type" class="font-semibold">Recto</dd></div>
        </dl>
      </section>

      <aside class="flex flex-col gap-4">
        <section class="rounded-2xl bg-zinc-900 p-6 text-white shadow-sm" aria-live="polite">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-zinc-400">Total estimado</p>
          <p id="total" class="tnum mt-2 text-5xl font-extrabold tracking-tight">$ 4.000.000</p>
          <p class="mt-1 text-sm text-zinc-400">COP · precio = longitud × valor por metro</p>
          <div class="mt-4 flex gap-2">
            <button id="copy" class="rounded-lg bg-white px-4 py-2 text-sm font-bold text-zinc-900 hover:bg-zinc-200">Copiar cotización</button>
            <a id="wa" href="#" target="_blank" rel="noreferrer" class="rounded-lg border border-zinc-700 px-4 py-2 text-sm font-semibold text-white hover:border-white">WhatsApp</a>
          </div>
          <p id="copy-ok" class="mt-2 hidden text-xs font-semibold text-emerald-300">Copiada al portapapeles.</p>
        </section>

        <section id="panel-admin" role="tabpanel" aria-labelledby="tab-admin" class="hidden rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-semibold">Administración de valores</h2>
          <p class="mt-1 text-xs text-zinc-500">Sin login (provisional). Los cambios aplican de inmediato.</p>
          <form id="admin-form" class="mt-4 grid min-w-0 grid-cols-1 gap-3 text-sm min-[420px]:grid-cols-2">
            <label class="grid min-w-0 gap-1">Recto $/m<input id="f-recto" required type="number" min="1" step="1000" class="tnum block w-full min-w-0 rounded-lg border border-zinc-300 px-3 py-2" /></label>
            <label class="grid min-w-0 gap-1">Curvo $/m<input id="f-curvo" required type="number" min="1" step="1000" class="tnum block w-full min-w-0 rounded-lg border border-zinc-300 px-3 py-2" /></label>
            <label class="grid min-w-0 gap-1">Long. mín (m)<input id="f-min" required type="number" min="0.5" step="0.5" class="block w-full min-w-0 rounded-lg border border-zinc-300 px-3 py-2" /></label>
            <label class="grid min-w-0 gap-1">Long. máx (m)<input id="f-max" required type="number" max="100" step="0.5" class="block w-full min-w-0 rounded-lg border border-zinc-300 px-3 py-2" /></label>
            <label class="col-span-full grid min-w-0 gap-1">Título<input id="f-titulo" type="text" maxlength="80" class="block w-full min-w-0 rounded-lg border border-zinc-300 px-3 py-2" /></label>
            <label class="col-span-full grid min-w-0 gap-1">Nota<input id="f-nota" type="text" maxlength="160" class="block w-full min-w-0 rounded-lg border border-zinc-300 px-3 py-2" /></label>
            <button class="col-span-full rounded-lg bg-zinc-900 px-4 py-2.5 font-bold text-white hover:bg-zinc-700 disabled:opacity-50">Guardar valores</button>
          </form>
          <p id="admin-msg" class="mt-2 hidden text-sm font-medium" role="status"></p>
          <p id="admin-updated" class="mt-1 text-xs text-zinc-400"></p>
        </section>

        <section class="rounded-2xl border border-dashed border-zinc-300 p-4 text-xs text-zinc-500">
          Uso interno del taller · valores editables en Administración.
        </section>
      </aside>
    </main>
  </div>

  <script>
    const $ = (id) => document.getElementById(id);
    const fmt = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
    let cfg = { rectoPorMetro: 800000, curvoPorMetro: 1000000, longitudMin: 1, longitudMax: 30, titulo: 'Cotiza tu tobogán', nota: 'Valores provisionales por metro lineal.', updatedAt: '' };
    let tipo = 'recto';

    async function load() {
      try {
        const r = await fetch('/api/prices');
        if (r.ok) cfg = await r.json();
      } catch {}
      applyConfig();
    }

    function applyConfig() {
      $('calc-title').textContent = cfg.titulo || 'Cotiza tu tobogán';
      $('calc-note').textContent = cfg.nota || '';
      $('price-recto-label').textContent = fmt.format(cfg.rectoPorMetro) + ' / m';
      $('price-curvo-label').textContent = fmt.format(cfg.curvoPorMetro) + ' / m';
      for (const [id, min] of [['longitud', cfg.longitudMin], ['longitud-num', cfg.longitudMin]]) {
        $(id).min = min; $(id).max = cfg.longitudMax;
      }
      $('range-hint').textContent = `Rango permitido: ${cfg.longitudMin} – ${cfg.longitudMax} m.`;
      $('f-recto').value = cfg.rectoPorMetro; $('f-curvo').value = cfg.curvoPorMetro;
      $('f-min').value = cfg.longitudMin; $('f-max').value = cfg.longitudMax;
      $('f-titulo').value = cfg.titulo || ''; $('f-nota').value = cfg.nota || '';
      $('admin-updated').textContent = cfg.updatedAt ? 'Actualizado: ' + new Date(cfg.updatedAt).toLocaleString('es-CO') : '';
      render();
    }

    function setTipo(t) {
      tipo = t;
      const isR = t === 'recto';
      $('type-recto').setAttribute('aria-checked', isR);
      $('type-curvo').setAttribute('aria-checked', !isR);
      $('type-recto').className = 'rounded-xl p-4 text-left ' + (isR ? 'border-2 border-zinc-900 bg-zinc-50' : 'border border-zinc-200 bg-white');
      $('type-curvo').className = 'rounded-xl p-4 text-left ' + (!isR ? 'border-2 border-zinc-900 bg-zinc-50' : 'border border-zinc-200 bg-white');
      render();
    }

    function render() {
      const len = parseFloat($('longitud-num').value);
      const err = $('quote-error');
      const unit = tipo === 'recto' ? cfg.rectoPorMetro : cfg.curvoPorMetro;
      if (!Number.isFinite(len) || len <= 0) { err.textContent = 'Ingresa una longitud válida mayor a 0.'; err.classList.remove('hidden'); return; }
      if (len < cfg.longitudMin || len > cfg.longitudMax) {
        err.textContent = `La longitud debe estar entre ${cfg.longitudMin} y ${cfg.longitudMax} m.`; err.classList.remove('hidden');
      } else err.classList.add('hidden');
      $('longitud').value = Math.min(cfg.longitudMax, Math.max(cfg.longitudMin, len));
      $('d-unit').textContent = fmt.format(unit) + ' / m';
      $('d-len').textContent = len + ' m';
      $('d-type').textContent = tipo === 'recto' ? 'Recto' : 'Curvo';
      $('total').textContent = fmt.format(len * unit);
      const txt = `${cfg.titulo}: tobogán ${tipo} de ${len} m = ${fmt.format(len * unit)} COP (${fmt.format(unit)}/m)`;
      $('wa').href = 'https://wa.me/?text=' + encodeURIComponent(txt);
    }

    $('type-recto').addEventListener('click', () => setTipo('recto'));
    $('type-curvo').addEventListener('click', () => setTipo('curvo'));
    $('longitud').addEventListener('input', (e) => { $('longitud-num').value = e.target.value; render(); });
    $('longitud-num').addEventListener('input', render);
    $('copy').addEventListener('click', async () => {
      const t = `${$('d-type').textContent} ${$('d-len').textContent} — ${$('total').textContent} COP`;
      try { await navigator.clipboard.writeText(t); $('copy-ok').classList.remove('hidden'); setTimeout(() => $('copy-ok').classList.add('hidden'), 2000); } catch {}
    });

    function showTab(which) {
      const q = which === 'quote';
      $('panel-quote').classList.toggle('hidden', false);
      $('panel-admin').classList.toggle('hidden', q);
      $('tab-quote').setAttribute('aria-selected', q);
      $('tab-admin').setAttribute('aria-selected', !q);
      $('tab-quote').className = 'rounded-lg px-4 py-2 text-sm font-semibold ' + (q ? 'bg-zinc-900 text-white' : 'border border-zinc-300 bg-white text-zinc-700');
      $('tab-admin').className = 'rounded-lg px-4 py-2 text-sm font-semibold ' + (!q ? 'bg-zinc-900 text-white' : 'border border-zinc-300 bg-white text-zinc-700');
    }
    $('tab-quote').addEventListener('click', () => showTab('quote'));
    $('tab-admin').addEventListener('click', () => showTab('admin'));

    $('admin-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = $('admin-msg');
      const btn = e.target.querySelector('button');
      btn.disabled = true; msg.classList.remove('hidden');
      msg.textContent = 'Guardando…'; msg.className = 'mt-2 text-sm font-medium text-zinc-500';
      try {
        const r = await fetch('/api/prices', { method: 'PUT', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ rectoPorMetro: Number($('f-recto').value), curvoPorMetro: Number($('f-curvo').value), longitudMin: Number($('f-min').value), longitudMax: Number($('f-max').value), titulo: $('f-titulo').value, nota: $('f-nota').value }) });
        const data = await r.json();
        if (!r.ok) throw new Error(data.error || 'No se pudo guardar');
        cfg = data; applyConfig();
        msg.textContent = 'Valores actualizados. La calculadora ya usa los nuevos precios.'; msg.className = 'mt-2 text-sm font-medium text-emerald-600';
      } catch (err) { msg.textContent = err.message; msg.className = 'mt-2 text-sm font-medium text-red-600'; }
      btn.disabled = false;
    });

    load();
  </script>
</Base>
